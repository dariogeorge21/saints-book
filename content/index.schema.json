{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SaintsBookContentIndex",
  "type": "object",
  "required": ["version", "defaultLanguage", "supportedLanguages", "items"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "string" },
    "title": { "type": "string" },
    "description": { "type": "string" },
    "defaultLanguage": { "type": "string", "enum": ["en", "ml", "hi"] },
    "supportedLanguages": {
      "type": "array",
      "items": { "type": "string", "enum": ["en", "ml", "hi"] }
    },
    "totalItems": { "type": "integer" },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "feastDate", "era", "path", "profile", "languages", "stories"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "latinName": { "type": "string" },
          "epithet": { "type": "string" },
          "feastDate": { "type": "string" },
          "feastMonth": { "type": "string" },
          "era": { "type": "string" },
          "location": { "type": "string" },
          "patronage": {
            "type": "array",
            "items": { "type": "string" }
          },
          "path": { "type": "string" },
          "profile": { "type": "string" },
          "languages": {
            "type": "array",
            "items": { "type": "string" }
          },
          "stories": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "properties": {
                "shortStory": { "type": "string" },
                "longStory": { "type": "string" }
              }
            }
          }
        }
      }
    }
  }
}
